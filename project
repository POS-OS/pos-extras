# The project buildsys/ builds (BUILD.md): "key value" lines.
# name: names the project's settings (pos-extras.conf), tools images and
# containers, and recipes archive.
name pos-extras
# pipeline: the pipeline of the project's packages and builds, the
# extras' (the engine's BUILD.md "Extras").
pipeline extras
# prefix: where the packages install; <version> is <product
# version>.<revision> of VERSION, <release> the build's product release
# (the engine's BUILD.md "Prefix"): every build has its own, so a build
# can take its build tools from another (tools setting).
prefix /apps/pos-extras/<version>-<release>
# engine: the pos commit whose buildsys/ ./build runs.
engine 00a93af95dd9b9f874fe8514a09718b7d59c4b1c
