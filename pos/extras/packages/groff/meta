# GNU roff: nroff, troff and their preprocessors (tbl, eqn, pic, refer),
# which man formats pages with; also a build tool (gettext's and less'
# builds run it). Its perl scripts (grog, gropdf, afmtodit) run the
# extras' perl.
build-requires pos-link perl
requires glibc gcc-runtime perl
replaces-host-rpm groff
